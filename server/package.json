{
  "name": "flashnext-server",
  "version": "0.1.0",
  "description": "FlashNext backend - spaced repetition service (Koa + TypeScript)",
  "main": "app.ts",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "typecheck": "tsc --noEmit",
    "prod:build": "node ./build.js",
    "prod:start": "cross-env NODE_ENV=production NODE_OPTIONS=--enable-source-maps node ./dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@open-spaced-repetition/binding": "^0.5.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^10.1.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-logger": "^4.0.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "ts-fsrs": "^5.4.2",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-logger": "^3.1.5",
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
