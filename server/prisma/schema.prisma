generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String   @default("Default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  states    PersonalKnowledgeState[]

  @@map("profiles")
}

model KnowledgeEntity {
  id           Int      @id @default(autoincrement())
  kind         String
  canonicalKey String   @unique @map("canonical_key")
  title        String
  summary      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  words        Word[]
  states       PersonalKnowledgeState[]

  @@index([kind])
  @@map("knowledge_entities")
}

model PersonalKnowledgeState {
  id             Int      @id @default(autoincrement())
  profileId      Int      @map("profile_id")
  entityId       Int      @map("entity_id")
  memoryPolicy   String   @default("NONE") @map("memory_policy")
  status         String   @default("UNKNOWN")
  confidence     Float    @default(0)
  firstSeenAt    DateTime? @map("first_seen_at")
  lastEvidenceAt DateTime? @map("last_evidence_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entity         KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([profileId, entityId])
  @@index([profileId, status])
  @@index([entityId])
  @@map("personal_knowledge_states")
}

model Deck {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  cards       Card[]

  @@map("decks")
}

model ReviewLog {
  id         Int      @id @default(autoincrement())
  cardId     Int      @map("card_id")
  rating     Int
  reviewAt   DateTime @default(now()) @map("review_at")
  state               Int       @default(0)
  interval            Int       @default(0)
  stability           Float     @default(0)
  difficulty          Float     @default(0)
  durationMs          Int       @default(0) @map("duration_ms")
  repsBefore          Int       @default(0) @map("reps_before")
  lapsesBefore        Int       @default(0) @map("lapses_before")
  learningStepsBefore Int       @default(0) @map("learning_steps_before")
  dueBefore           DateTime? @map("due_before")

  @@index([cardId])
  @@index([reviewAt])
  @@map("review_logs")
}

model FsrsParam {
  id                Int       @id @default(1)
  w                 String
  updatedAt         DateTime  @default(now()) @map("updated_at")
  source            String    @default("legacy")
  revlogMigratedAt  DateTime? @map("revlog_migrated_at")

  @@map("fsrs_params")
}

model WordnetSynset {
  id     String         @id
  pos    String
  gloss  String         @default("")
  senses WordnetSense[]

  @@map("wordnet_synsets")
}

model WordnetSense {
  id         Int           @id @default(autoincrement())
  synsetId   String        @map("synset_id")
  lemma      String
  semcorFreq Int           @default(0) @map("semcor_freq")
  senseRank  Int           @default(1) @map("sense_rank")
  synset     WordnetSynset @relation(fields: [synsetId], references: [id], onDelete: Cascade)

  @@unique([synsetId, lemma])
  @@index([lemma])
  @@map("wordnet_senses")
}

model AppSetting {
  id           Int      @id @default(1)
  newPerDay    Int      @default(20) @map("new_per_day")
  reviewPerDay Int      @default(200) @map("review_per_day")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Word {
  id          Int       @id @default(autoincrement())
  knowledgeEntityId Int? @unique @map("knowledge_entity_id")
  headword    String    @unique
  rank        Int?      @unique
  pos         String    @default("")
  phonetic    String    @default("")
  phoneticLegacy String? @map("phonetic_legacy")
  phoneticProfile String @default("legacy") @map("phonetic_profile")
  translation String    @default("")
  knowledgeEntity KnowledgeEntity? @relation(fields: [knowledgeEntityId], references: [id], onDelete: SetNull)
  cards       Card[]
  tags        WordTag[]
  senses      WordSense[]
  ieltsUsages IeltsUsage[]
  pronunciations WordPronunciation[]

  @@map("words")
}

model WordPronunciation {
  id Int @id @default(autoincrement())
  wordId Int @map("word_id")
  sourceKey String @unique @map("source_key")
  source String
  revision String
  pos String
  usage String @default("")
  accent String
  rawIpa String @map("raw_ipa")
  displayIpa String @default("") @map("display_ipa")
  status String
  note String @default("")
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, status])
  @@map("word_pronunciations")
}

model IeltsUsage {
  id          Int    @id @default(autoincrement())
  wordId      Int    @map("word_id")
  source      String
  sourceUrl   String @map("source_url")
  sourceOrder Int    @map("source_order")
  chapter     String
  displayWord String @map("display_word")
  pos         String
  meaning     String
  phonetic    String @default("")
  phoneticLegacy String? @map("phonetic_legacy")
  phoneticProfile String @default("legacy") @map("phonetic_profile")
  word        Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([source, sourceOrder])
  @@index([wordId])
  @@map("ielts_usages")
}

model WordSense {
  id       Int    @id @default(autoincrement())
  wordId   Int    @map("word_id")
  senseIdx Int    @map("sense_idx")
  gloss    String @default("")
  examples String @default("[]")
  zh       String @default("[]")
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_senses")
}

model WordTag {
  id     Int    @id @default(autoincrement())
  wordId Int    @map("word_id")
  scheme String
  level  Int
  label  String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, scheme, level])
  @@index([scheme, level])
  @@map("word_tags")
}

model Card {
  id            Int       @id @default(autoincrement())
  deckId        Int       @map("deck_id")
  wordId        Int?      @map("word_id")
  front         String
  back          String
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  state         Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  learningSteps Int       @default(0) @map("learning_steps")
  interval      Int       @default(0)
  due           DateTime  @default(now())
  lastReview    DateTime? @map("last_review")
  createdAt     DateTime  @default(now()) @map("created_at")
  deck          Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word          Word?     @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([deckId])
  @@index([due])
  @@index([wordId])
  @@map("cards")
}
